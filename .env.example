# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit .env and never put the key in frontend code (no VITE_ prefix!).

# Your key. The provider is detected from the prefix:  gsk_...  → Groq    xai-...  → xAI Grok
AI_API_KEY=

# Optional. Leave blank for defaults (Groq: openai/gpt-oss-120b, xAI: grok-3-mini).
# Groq alternatives: llama-3.3-70b-versatile, openai/gpt-oss-20b
AI_MODEL=

# Optional: force the provider (groq | xai) if auto-detection is wrong.
AI_PROVIDER=

# Extra origins allowed to call /api (same-host is always allowed). Comma separated.
ALLOWED_ORIGINS=
